# Copy to .env and fill in your keys. Never commit .env.

# Chat model used for both extraction and decision (benchmark compares claude-haiku-5-5 vs claude-sonnet-5-5)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Embeddings only (text-embedding-3-small)
OPENAI_API_KEY=

# Matches docker-compose.yml for local development
DATABASE_URL=postgresql://app:app@localhost:5432/permissibility
